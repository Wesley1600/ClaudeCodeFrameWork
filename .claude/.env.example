# MCP API Connector - Environment Variables
# Copy this file to .env and fill in your API tokens

# GitHub Personal Access Token
# Get one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Figma API Token
# Get one at: https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=figd_your_token_here

# Slack Bot Token
# Get one at: https://api.slack.com/apps
SLACK_TOKEN=xoxb-your-token-here

# Linear API Key
# Get one at: https://linear.app/settings/api
LINEAR_TOKEN=lin_api_your_key_here

# Custom API Keys (add as needed)
CUSTOM_API_KEY=your_custom_key_here
