# Qwen3 Embedding Service Configuration
# Copy to .env and customize for your environment

# Model Configuration
EMBEDDING_MODEL_REPO=Qwen/Qwen3-Embedding-4B
EMBEDDING_MODEL_PATH=/home/user/.cache/embedding_models/Qwen3-Embedding-4B
EMBEDDING_BASE_DIM=2560

# Performance Settings
EMBEDDING_MAX_BATCH_SIZE=32
EMBEDDING_MAX_INPUT_LENGTH=8192
EMBEDDING_REQUEST_TIMEOUT=120.0

# Server Settings
EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=8000
EMBEDDING_ALLOW_ORIGINS=*

# For production, specify allowed origins:
# EMBEDDING_ALLOW_ORIGINS=http://localhost:3000,https://your-domain.com
