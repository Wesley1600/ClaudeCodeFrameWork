# Build Automation Configuration
# This file is sourced by all bash scripts

# Build settings
BUILD_DIR="build"
BUILD_TYPE="release"

# Test settings
TEST_REPORT_DIR="test-reports"
TEST_TIMEOUT=300  # seconds

# Deployment settings
DEPLOY_ENV="dev"
DEPLOY_TIMEOUT=600  # seconds

# Logging
LOG_LEVEL="info"
LOG_DIR="logs"

# Notifications (optional)
NOTIFY_ON_SUCCESS=false
NOTIFY_ON_FAILURE=true
